<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand accent, fixed across light and dark modes -->
    <Color x:Key="AccentColor">#2563EB</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentBrushLight" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>

    <!-- Secondary accents, used purposefully for variety (category bars,
         icons), same palette as the website -->
    <SolidColorBrush x:Key="TealBrush" Color="#0D9488"/>
    <SolidColorBrush x:Key="VioletBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="RoseBrush" Color="#E11D48"/>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="0.55"/>
        <GradientStop Color="#0D9488" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#EFF6FF"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#E2E8F0"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>

</ResourceDictionary>
