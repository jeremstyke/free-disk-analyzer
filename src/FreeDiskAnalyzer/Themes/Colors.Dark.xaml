<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand accent, fixed across light and dark modes -->
    <Color x:Key="AccentColor">#2563EB</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentBrushLight" Color="#1E3A5F"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>

    <!-- Secondary accents, used purposefully for variety (category bars,
         icons), same palette as the website -->
    <SolidColorBrush x:Key="TealBrush" Color="#2DD4BF"/>
    <SolidColorBrush x:Key="VioletBrush" Color="#A78BFA"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="RoseBrush" Color="#FB7185"/>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#273549"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#111C2E"/>
    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1D3A8A" Offset="0"/>
        <GradientStop Color="#5B21B6" Offset="0.55"/>
        <GradientStop Color="#0F766E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#1E3A5F"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="BorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#334155"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>

</ResourceDictionary>
