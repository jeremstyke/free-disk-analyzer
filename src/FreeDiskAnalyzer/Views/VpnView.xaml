<UserControl x:Class="FreeDiskAnalyzer.Views.VpnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:FreeDiskAnalyzer.Resources">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,24" MaxWidth="720" HorizontalAlignment="Left">

            <!-- Hero -->
            <Border Background="{DynamicResource AccentBrushLight}" CornerRadius="14" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="999" Padding="10,4"
                            HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBlock Text="{x:Static res:Strings.Vpn_ComingSoonBadge}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="{x:Static res:Strings.Vpn_Title}" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{x:Static res:Strings.Vpn_Subtitle}" TextWrapping="Wrap"
                               Style="{StaticResource BodyTextStyle}"/>
                </StackPanel>
            </Border>

            <!-- Locations -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Vpn_LocationsTitle}" FontWeight="SemiBold" FontSize="15"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                    <UniformGrid Columns="3" Rows="3">
                        <TextBlock Margin="0,0,0,12" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="🇺🇸" FontSize="16"/><Run Text=" United States"/>
                        </TextBlock>
                        <TextBlock Margin="0,0,0,12" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="🇬🇧" FontSize="16"/><Run Text=" United Kingdom"/>
                        </TextBlock>
                        <TextBlock Margin="0,0,0,12" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="🇫🇷" FontSize="16"/><Run Text=" France"/>
                        </TextBlock>
                        <TextBlock Margin="0,0,0,12" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="🇩🇪" FontSize="16"/><Run Text=" Germany"/>
                        </TextBlock>
                        <TextBlock Margin="0,0,0,12" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="🇳🇱" FontSize="16"/><Run Text=" Netherlands"/>
                        </TextBlock>
                        <TextBlock Margin="0,0,0,12" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="🇨🇭" FontSize="16"/><Run Text=" Switzerland"/>
                        </TextBlock>
                        <TextBlock Margin="0,0,0,12" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="🇯🇵" FontSize="16"/><Run Text=" Japan"/>
                        </TextBlock>
                        <TextBlock Margin="0,0,0,12" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="🇸🇬" FontSize="16"/><Run Text=" Singapore"/>
                        </TextBlock>
                        <TextBlock Margin="0,0,0,12" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="🇨🇦" FontSize="16"/><Run Text=" Canada"/>
                        </TextBlock>
                    </UniformGrid>
                    <TextBlock Text="{x:Static res:Strings.Vpn_LocationsNote}" Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Static res:Strings.Vpn_Body}" TextWrapping="Wrap"
                       Style="{StaticResource BodyTextStyle}" Margin="0,0,0,20"/>

            <!-- Actions -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Vpn_MeanwhileTitle}" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="{x:Static res:Strings.Vpn_MeanwhileBody}" TextWrapping="Wrap"
                                   Style="{StaticResource BodyTextStyle}" Margin="0,0,0,14"/>
                        <Button Content="{x:Static res:Strings.Vpn_SecureNow}" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding OpenNordVpnCommand}"/>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap">
                            <Run Text="🔗"/>
                            <Run Text="{x:Static res:Strings.Dashboard_AffiliateDisclosure}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Vpn_SupportTitle}" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="{x:Static res:Strings.Vpn_SupportBody}" TextWrapping="Wrap"
                                   Style="{StaticResource BodyTextStyle}" Margin="0,0,0,14"/>
                        <Button Content="{x:Static res:Strings.Vpn_SupportButton}" Style="{StaticResource OutlineButtonStyle}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding OpenSupportDevelopmentCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Button Content="{x:Static res:Strings.Vpn_LearnMore}" Style="{StaticResource OutlineButtonStyle}"
                    HorizontalAlignment="Left" Command="{Binding OpenVpnPageCommand}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
