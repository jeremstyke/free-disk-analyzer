<UserControl x:Class="FreeDiskAnalyzer.Views.VpnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:FreeDiskAnalyzer.Resources">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,24" MaxWidth="720" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{x:Static res:Strings.Vpn_Title}" Style="{StaticResource TitleTextStyle}"/>
                <Border Background="{DynamicResource AccentBrush}" CornerRadius="999" Padding="10,4" Margin="12,4,0,0" VerticalAlignment="Top">
                    <TextBlock Text="{x:Static res:Strings.Vpn_ComingSoonBadge}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>
            </StackPanel>
            <TextBlock Text="{x:Static res:Strings.Vpn_Subtitle}" Style="{StaticResource SubtitleTextStyle}"
                       TextWrapping="Wrap" Margin="0,0,0,20"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Vpn_LocationsTitle}" FontWeight="SemiBold" FontSize="15"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <UniformGrid Columns="3" Rows="3">
                        <TextBlock Text="🇺🇸 United States" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="🇬🇧 United Kingdom" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="🇫🇷 France" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="🇩🇪 Germany" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="🇳🇱 Netherlands" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="🇨🇭 Switzerland" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="🇯🇵 Japan" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="🇸🇬 Singapore" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="🇨🇦 Canada" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </UniformGrid>
                    <TextBlock Text="{x:Static res:Strings.Vpn_LocationsNote}" Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Static res:Strings.Vpn_Body}" TextWrapping="Wrap"
                       Style="{StaticResource BodyTextStyle}" Margin="0,0,0,24"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Vpn_MeanwhileTitle}" FontWeight="SemiBold" FontSize="15"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{x:Static res:Strings.Vpn_MeanwhileBody}" TextWrapping="Wrap"
                               Style="{StaticResource BodyTextStyle}" Margin="0,0,0,12"/>
                    <Button Content="{x:Static res:Strings.Vpn_SecureNow}" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left" Command="{Binding OpenNordVpnCommand}"/>
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource CaptionTextStyle}">
                        <Run Text="🔗"/>
                        <Run Text="{x:Static res:Strings.Dashboard_AffiliateDisclosure}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Vpn_SupportTitle}" FontWeight="SemiBold" FontSize="15"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{x:Static res:Strings.Vpn_SupportBody}" TextWrapping="Wrap"
                               Style="{StaticResource BodyTextStyle}" Margin="0,0,0,12"/>
                    <Button Content="{x:Static res:Strings.Vpn_SupportButton}" Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding OpenSupportDevelopmentCommand}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
