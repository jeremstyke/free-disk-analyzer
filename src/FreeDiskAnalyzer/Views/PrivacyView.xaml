<UserControl x:Class="FreeDiskAnalyzer.Views.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:FreeDiskAnalyzer.Resources">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,32" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="{x:Static res:Strings.Privacy_Title}" Style="{StaticResource TitleTextStyle}"/>
            <TextBlock Text="{x:Static res:Strings.Privacy_Tagline}" Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,24"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Privacy_StaysLocal_Title}" FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="{x:Static res:Strings.Privacy_StaysLocal_Body}"
                               Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Privacy_NeverCollected_Title}" FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="{x:Static res:Strings.Privacy_NeverCollected_Body}"
                               Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Privacy_Offline_Title}" FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="{x:Static res:Strings.Privacy_Offline_Body}"
                               Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Privacy_Affiliate_Title}" FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="{x:Static res:Strings.Privacy_Affiliate_Body}"
                               Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
