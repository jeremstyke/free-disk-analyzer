<UserControl x:Class="FreeDiskAnalyzer.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:FreeDiskAnalyzer.Resources">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,32">

            <TextBlock Text="{x:Static res:Strings.Settings_Title}" Style="{StaticResource TitleTextStyle}"/>
            <TextBlock Text="{x:Static res:Strings.Settings_Subtitle}" Style="{StaticResource SubtitleTextStyle}"
                       Margin="0,4,0,24"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Settings_Language}" FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberPath="DisplayName" Width="160" HorizontalAlignment="Left"/>
                    <TextBlock Text="{x:Static res:Strings.Settings_LanguageRestartNote}" Style="{StaticResource CaptionTextStyle}"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding LanguageChanged, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Settings_Theme}" FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" Width="160"
                              HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox Content="{x:Static res:Strings.Settings_StartWithWindows}" IsChecked="{Binding StartWithWindows}"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox Content="{x:Static res:Strings.Settings_Analytics}" IsChecked="{Binding AnalyticsEnabled}"
                              Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{x:Static res:Strings.Settings_AnalyticsNote}"
                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Button Content="{x:Static res:Strings.Settings_Reset}" Command="{Binding ResetSettingsCommand}"
                    HorizontalAlignment="Left"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
