<UserControl x:Class="FreeDiskAnalyzer.Views.BlogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:FreeDiskAnalyzer.Resources">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,8,0,16">
            <TextBlock Text="{x:Static res:Strings.Dashboard_FromTheBlog}" FontWeight="SemiBold" FontSize="16"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Dashboard_ReleaseNotes}" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"
                           Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{x:Static res:Strings.Blog_ReleaseNotesEnglishOnly}" Style="{StaticResource CaptionTextStyle}"
                           Margin="0,-4,0,8"
                           Visibility="{Binding IsFrenchUi, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding LatestReleaseNotes}" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="14">
                                <Button HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding DataContext.OpenArticleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="SemiBold"
                                               Style="{StaticResource BodyTextStyle}"/>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{x:Static res:Strings.Dashboard_GuidesAndComparisons}" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"
                           Visibility="{Binding HasArticles, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding LatestArticles}" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="14">
                                <Button HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding DataContext.OpenArticleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="SemiBold"
                                               Style="{StaticResource BodyTextStyle}"/>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="{x:Static res:Strings.Dashboard_ViewBlog}" Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding OpenBlogCommand}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
