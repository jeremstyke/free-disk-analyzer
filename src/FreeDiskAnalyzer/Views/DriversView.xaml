<UserControl x:Class="FreeDiskAnalyzer.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:FreeDiskAnalyzer.Resources">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,8,0,16">
            <TextBlock Text="{x:Static res:Strings.Drivers_Title}" FontWeight="SemiBold" FontSize="16"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="{x:Static res:Strings.Drivers_Body}" TextWrapping="Wrap"
                       Style="{StaticResource BodyTextStyle}" Margin="0,0,0,16"/>
            <Button Content="{x:Static res:Strings.Drivers_OpenWindowsUpdate}" Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Left" Command="{Binding OpenWindowsUpdateCommand}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Drivers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ClickableCardStyle}" Margin="0,0,0,8"
                                Command="{Binding DataContext.ShowDriverDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Style="{StaticResource CaptionTextStyle}">
                                        <Run Text="{Binding Manufacturer, Mode=OneWay}"/>
                                        <Run Text=" · v"/>
                                        <Run Text="{Binding Version, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding AgeDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <Border Grid.Column="1" Background="#F59E0B" CornerRadius="999" Padding="8,3" Margin="8,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsPotentiallyOld, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{x:Static res:Strings.Drivers_OldBadge}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>

                                <TextBlock Grid.Column="2" Text="{Binding LinkLabel, StringFormat='🔧 {0}'}" Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
