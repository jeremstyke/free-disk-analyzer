<UserControl x:Class="FreeDiskAnalyzer.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:FreeDiskAnalyzer.Resources">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
        <TextBlock Text="{x:Static res:Strings.AppTitle}" Style="{StaticResource TitleTextStyle}" HorizontalAlignment="Center"/>
        <Border Background="#D97706" CornerRadius="999" Padding="10,4" HorizontalAlignment="Center" Margin="0,8,0,0">
            <TextBlock Text="BETA" FontSize="11" FontWeight="Bold" Foreground="White"/>
        </Border>
        <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource SubtitleTextStyle}">
            <Run Text="{x:Static res:Strings.About_Version}"/>
            <Run Text=" "/>
            <Run Text="{Binding VersionDisplay, Mode=OneWay}"/>
        </TextBlock>
        <TextBlock Text="{x:Static res:Strings.About_BetaNote}" Style="{StaticResource CaptionTextStyle}"
                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
        <TextBlock Text="{x:Static res:Strings.About_Tagline}" Style="{StaticResource BodyTextStyle}"
                   HorizontalAlignment="Center" Margin="0,20,0,20"/>
        <Button Content="{x:Static res:Strings.About_ViewGitHub}" Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Center" Command="{Binding OpenGitHubCommand}" Margin="0,0,0,12"/>
        <Button Content="{x:Static res:Strings.Sidebar_ReportBug}" Style="{StaticResource OutlineButtonStyle}"
                HorizontalAlignment="Center" Command="{Binding ReportBugCommand}" Margin="0,0,0,12"/>
        <Button Content="{x:Static res:Strings.About_Coffee}" HorizontalAlignment="Center"
                Command="{Binding OpenCoffeeCommand}" Margin="0,0,0,20"/>
        <StackPanel Visibility="{Binding HasSupporters, Converter={StaticResource BoolToVis}}" Margin="0,0,0,20">
            <TextBlock Text="{x:Static res:Strings.About_SupportersTitle}" Style="{StaticResource CaptionTextStyle}"
                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Supporters}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="999" Padding="10,4" Margin="4">
                            <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <TextBlock Text="{x:Static res:Strings.About_License}" Style="{StaticResource CaptionTextStyle}"
                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>
    </StackPanel>
</UserControl>
