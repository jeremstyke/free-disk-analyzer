<UserControl x:Class="FreeDiskAnalyzer.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
        <TextBlock Text="Free Disk Analyzer" Style="{StaticResource TitleTextStyle}" HorizontalAlignment="Center"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0" Style="{StaticResource SubtitleTextStyle}">
            <Run Text="Version "/>
            <Run Text="{Binding VersionDisplay, Mode=OneWay}"/>
        </TextBlock>
        <TextBlock Text="Free forever. Privacy first." Style="{StaticResource BodyTextStyle}"
                   HorizontalAlignment="Center" Margin="0,20,0,20"/>
        <Button Content="View on GitHub" Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Center" Command="{Binding OpenGitHubCommand}" Margin="0,0,0,20"/>
        <TextBlock Text="All rights reserved. See LICENSE in the repository." Style="{StaticResource CaptionTextStyle}"
                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
    </StackPanel>
</UserControl>
