<UserControl x:Class="FreeDiskAnalyzer.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeDiskAnalyzer.Controls"
             xmlns:res="clr-namespace:FreeDiskAnalyzer.Resources">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,32">

            <TextBlock Text="{x:Static res:Strings.Dashboard_Title}" Style="{StaticResource TitleTextStyle}"/>
            <TextBlock Text="{x:Static res:Strings.Dashboard_Subtitle}"
                       Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,24"/>

            <!-- Drive cards -->
            <ItemsControl ItemsSource="{Binding Drives}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Width="220" Margin="0,0,16,16" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding RootPath}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,12"/>
                                <ProgressBar Value="{Binding UsedPercentage, Mode=OneWay}" Maximum="100"
                                             Style="{StaticResource ThinProgressBarStyle}"/>
                                <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="{Binding UsedDisplay, Mode=OneWay}"/>
                                    <Run Text="{x:Static res:Strings.Dashboard_UsedOf}"/>
                                    <Run Text="{Binding TotalDisplay, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Selected drive detail + last scan summary -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{x:Static res:Strings.Dashboard_Storage}" FontWeight="SemiBold" FontSize="16"
                                   HorizontalAlignment="Left" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,16"/>
                        <controls:DonutProgressRing UsedPercentage="{Binding SelectedDrive.UsedPercentage, Mode=OneWay}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Center">
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="{x:Static res:Strings.Dashboard_Used}" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Text="{Binding SelectedDrive.UsedDisplay}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.Dashboard_Free}" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Text="{Binding SelectedDrive.FreeDisplay}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Dashboard_LastScan}" FontWeight="SemiBold" FontSize="16"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding LastScanSummary}" TextWrapping="Wrap"
                                   Style="{StaticResource BodyTextStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Storage by category -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Dashboard_StorageByCategory}" FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    <ItemsControl ItemsSource="{Binding CategoryBreakdown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                               Style="{StaticResource BodyTextStyle}"/>
                                    <Border Grid.Column="1" Background="{DynamicResource TrackBrush}" CornerRadius="4"
                                            Height="10" VerticalAlignment="Center" Margin="8,0" Width="200">
                                        <Border Background="{Binding BarBrush}" CornerRadius="4"
                                                HorizontalAlignment="Left"
                                                Width="{Binding BarPercentage, Converter={StaticResource PercentageToWidthConverter}, ConverterParameter=200}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding BytesDisplay}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- From the blog -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Dashboard_FromTheBlog}" FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                    <TextBlock Text="{x:Static res:Strings.Dashboard_ReleaseNotes}" Style="{StaticResource CaptionTextStyle}"
                               FontWeight="SemiBold" Margin="0,0,0,4"
                               Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding LatestReleaseNotes}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="0,6"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding DataContext.OpenArticleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Style="{StaticResource BodyTextStyle}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{x:Static res:Strings.Dashboard_GuidesAndComparisons}" Style="{StaticResource CaptionTextStyle}"
                               FontWeight="SemiBold" Margin="0,0,0,4"
                               Visibility="{Binding HasArticles, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding LatestArticles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="0,6"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding DataContext.OpenArticleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Style="{StaticResource BodyTextStyle}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="{x:Static res:Strings.Dashboard_ViewBlog}" Style="{StaticResource OutlineButtonStyle}"
                            Margin="0,8,0,0" Command="{Binding OpenBlogCommand}"/>
                </StackPanel>
            </Border>

            <!-- NordVPN affiliate card -->
            <Border Style="{StaticResource CardStyle}" Background="{DynamicResource AccentBrushLight}">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Dashboard_NordVpnTitle}" FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{x:Static res:Strings.Dashboard_NordVpnBody}" TextWrapping="Wrap"
                               Style="{StaticResource BodyTextStyle}" Margin="0,0,0,12"/>
                    <Button Content="{x:Static res:Strings.Dashboard_LearnMore}" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left" Command="{Binding OpenNordVpnCommand}"/>
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap">
                        <Run Text="🔗"/>
                        <Run Text="{x:Static res:Strings.Dashboard_AffiliateDisclosure}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
