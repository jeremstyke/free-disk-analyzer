<UserControl x:Class="FreeDiskAnalyzer.Views.BrowsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:FreeDiskAnalyzer.Resources">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,8,0,16">
            <TextBlock Text="{x:Static res:Strings.Browsers_Title}" FontWeight="SemiBold" FontSize="16"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="{x:Static res:Strings.Browsers_Body}" TextWrapping="Wrap"
                       Style="{StaticResource BodyTextStyle}" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static res:Strings.Browsers_RescanCommand}" Margin="0,0,12,0"
                        Command="{Binding ScanCommand}"/>
                <Button Content="{x:Static res:Strings.Browsers_SelectAll}" Margin="0,0,12,0"
                        Command="{Binding SelectAllCommand}"/>
                <Button Content="{x:Static res:Strings.Browsers_DeselectAll}" Margin="0,0,12,0"
                        Command="{Binding DeselectAllCommand}"/>
                <Button Content="{x:Static res:Strings.Browsers_Clean}" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding CleanSelectedCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                       Margin="0,12,0,0"/>
            <TextBlock Text="{x:Static res:Strings.Browsers_Scanning}" Style="{StaticResource CaptionTextStyle}"
                       Margin="0,8,0,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{x:Static res:Strings.Browsers_Cleaning}" Style="{StaticResource CaptionTextStyle}"
                       Margin="0,8,0,0" Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{x:Static res:Strings.Browsers_RiskLegend}" Style="{StaticResource CaptionTextStyle}"
                       TextWrapping="Wrap" Margin="0,8,0,16"/>

            <TextBlock Text="{x:Static res:Strings.Settings_CookieWhitelist}" FontWeight="SemiBold" FontSize="15"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="{x:Static res:Strings.Settings_CookieWhitelistNote}"
                       Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBox Text="{Binding CookieWhitelistText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="140"
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <Run Text="{Binding BrowserName, Mode=OneWay}"/>
                                        <Run Text=" - "/>
                                        <Run Text="{Binding CategoryLabel, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{Binding RiskLevel, Converter={StaticResource RiskLevelToBrushConverter}}"/>
                                    <TextBlock Text="{Binding SizeDisplay}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource CardStyle}" Background="{DynamicResource AccentBrushLight}" Margin="0,12,0,0"
                    Visibility="{Binding HasCleaned, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Analyze_DeleteMeTitle}" FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{x:Static res:Strings.Analyze_DeleteMeBody}" TextWrapping="Wrap"
                               Style="{StaticResource BodyTextStyle}" Margin="0,0,0,12"/>
                    <Button Content="{x:Static res:Strings.Dashboard_LearnMore}" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left" Command="{Binding OpenDeleteMeCommand}"/>
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap">
                        <Run Text="🔗"/>
                        <Run Text="{x:Static res:Strings.Dashboard_AffiliateDisclosure}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
