<Window x:Class="FreeDiskAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:FreeDiskAnalyzer.Resources"
        Title="PurgeCore (Beta)"
        Height="720" Width="1200" MinHeight="600" MinWidth="960"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarGradientBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PurgeCore" FontSize="17" FontWeight="Bold"
                                   TextWrapping="Wrap" Foreground="White"/>
                        <Border Background="#D97706" CornerRadius="999" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             From="1" To="1.12" Duration="0:0:1.1">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             From="1" To="1.12" Duration="0:0:1.1">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <TextBlock Text="BETA" FontSize="9" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <ListBox DockPanel.Dock="Top"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                         Style="{StaticResource NavListStyle}"
                         ItemContainerStyle="{StaticResource NavListItemStyle}"
                         Margin="12,0,12,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Height="30">
                                <Border Background="#33FFFFFF" CornerRadius="8" Width="28" Height="28" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource AppIconFontFamily}"
                                               Foreground="{Binding IconBrush}" HorizontalAlignment="Center"
                                               FontSize="15" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Label}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="White" FontWeight="Medium"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button DockPanel.Dock="Bottom" Command="{Binding OpenCoffeeCommand}"
                        Style="{StaticResource OutlineButtonStyle}"
                        Foreground="White" BorderBrush="#66FFFFFF"
                        Margin="12,0,12,16">
                    <TextBlock Foreground="White">
                        <Run Text="☕"/>
                        <Run Text="{x:Static res:Strings.About_Coffee}"/>
                    </TextBlock>
                </Button>

                <Button DockPanel.Dock="Bottom" Command="{Binding ReportBugCommand}"
                        Style="{StaticResource OutlineButtonStyle}"
                        Foreground="White" BorderBrush="#66FFFFFF"
                        Margin="12,0,12,8">
                    <TextBlock Foreground="White">
                        <Run Text="🐞"/>
                        <Run Text="{x:Static res:Strings.Sidebar_ReportBug}"/>
                    </TextBlock>
                </Button>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource AccentGradientBrush}"
                    Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BoolToVis}}">
                <Grid Margin="24,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding UpdateBannerText}" Foreground="White"
                               VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Command="{Binding DownloadAndInstallUpdateCommand}"
                            Margin="0,0,12,0" Padding="14,6" Background="White" Foreground="{DynamicResource AccentBrush}"
                            BorderThickness="0" Cursor="Hand">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{x:Static res:Strings.Update_Download}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True">
                                            <Setter Property="Text" Value="{x:Static res:Strings.Update_Downloading}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding DismissUpdateBannerCommand}"
                            Content="{x:Static res:Strings.Update_Dismiss}"
                            Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </Border>

            <ContentControl x:Name="PageContent" Grid.Row="1" Content="{Binding CurrentPage}" Margin="32"/>
        </Grid>
    </Grid>
</Window>
